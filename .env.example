# ===== 曹昌洵专属教育系统 · 环境配置 =====
# 复制这个文件成 .env，然后把下面的空填上。

# ---------- MiniMax M3（AI 批改 / 答疑）----------
# key 和域名是绑定的，配错了会 401。
#   国内站：https://api.minimaxi.com/v1
#   国际站：https://api.minimax.io/v1
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# 思考模式。批改要快、答案要稳，默认关掉；想要更认真的推理就改成 enabled。
MINIMAX_THINKING=disabled

# 单次 AI 调用超时（毫秒）
MINIMAX_TIMEOUT_MS=60000

# ---------- 服务 ----------
PORT=4000

# 监听地址。默认只监听本机，画面和录像都是家里的隐私，没必要默认暴露到局域网。
# 需要「爸爸手机同步实时画面」时，改成 HOST=0.0.0.0 重启，
# 然后用 http://<本机局域网IP>:4000/watch 在手机上打开观看页（需要家长 PIN）。
# 用完建议改回 127.0.0.1。
HOST=127.0.0.1

# 试看模式：解除「未来日期不可打开」的限制，方便开学前先熟悉系统。
# 正式使用时保持注释掉。
# PREVIEW=1

# ---------- 家长区 ----------
# 家长 PIN（4 位数字），可以在家长区里改
PARENT_PIN=0000

# 每日作业的软提醒截止时间（HH:MM）。留空表示不提醒。
DAILY_DEADLINE=21:00

# ---------- 其它 ----------
# 英语跟读是否用 AI 打相似度分（需要语音转写，先留 0）
ENABLE_SPEECH_SCORING=0
